#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

echo "=== NDC Pipeline Build ==="

# Load environment
if [ -f .env ]; then
    export $(grep -v '^#' .env | grep -v '^\s*$' | xargs)
fi

# Docker compose command
if [ -f .docker-compose-cmd ]; then
    DOCKER_COMPOSE=$(cat .docker-compose-cmd)
elif docker compose version &> /dev/null; then
    DOCKER_COMPOSE="docker compose"
else
    DOCKER_COMPOSE="docker-compose"
fi

echo "Running database migrations..."
for f in db/migrations/*.sql; do
    echo "  Applying $f..."
    $DOCKER_COMPOSE exec -T postgres psql -U "$DB_USER" -d "$DB_NAME" -q < "$f"
done

echo ""
echo "Build complete. Database schema is ready."
echo "Run ./run_pipeline to start data ingestion."
